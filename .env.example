# Copy this file to .env and replace the values.
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=hiresphere_db
DATABASE_USER=hiresphere_app
DATABASE_PASSWORD=replace-with-your-mysql-password
MAX_CONTENT_LENGTH=5242880
# For deployment, set COOKIE_SECURE=1 when HTTPS is enabled.
COOKIE_SECURE=0
# Alternatively, use DATABASE_URL=mysql+pymysql://user:password@host:3306/database?charset=utf8mb4

# Optional SMTP settings for password reset and email alerts. Configure with your provider.
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=1
MAIL_DEFAULT_SENDER=HireSphere <your-email@example.com>
